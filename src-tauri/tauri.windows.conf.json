{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Novaframe Wallpaper",
        "url": "index.html?mode=main",
        "width": 1920,
        "height": 1080,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnBottom": true,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "Novaframe Controls",
        "width": 30,
        "height": 30,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "acceptFirstMouse": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true,
        "url": "index.html?mode=settings"
      }
    ]
  }
}
